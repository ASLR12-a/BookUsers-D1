<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="versionuni.Listado">
  <grid id="27dc6" binding="panelPrincipalListado" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="5270f" class="javax.swing.JButton" binding="btnVerDetalle">
        <constraints border-constraint="South"/>
        <properties>
          <font name="Palatino Linotype" size="18" style="1"/>
          <text value="Ver detalle"/>
        </properties>
      </component>
      <component id="4138e" class="javax.swing.JList" binding="lstUsuario">
        <constraints border-constraint="Center"/>
        <properties>
          <font name="Arial" size="12" style="0"/>
        </properties>
      </component>
      <component id="17c3f" class="javax.swing.JButton" binding="eliminarButton">
        <constraints border-constraint="East"/>
        <properties>
          <font name="Candara" size="14" style="1"/>
          <text value="Eliminar Usuarios"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
